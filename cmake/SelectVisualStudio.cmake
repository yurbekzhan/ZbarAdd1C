# Select the VS installation and toolset already used by the primary build.
# In particular, do not request VS 2022/v143 from a VS 2026/Ninja build.
function(select_secondary_visual_studio)
  set(instance "${CMAKE_GENERATOR_INSTANCE}")
  if(CMAKE_GENERATOR MATCHES "^Visual Studio ")
    set(generator "${CMAKE_GENERATOR}")
  else()
    file(TO_CMAKE_PATH "${CMAKE_C_COMPILER}" compiler)
    if(NOT compiler MATCHES "^(.*)/VC/Tools/MSVC/[^/]+/bin/[^/]+/[^/]+/cl[.]exe$")
      message(FATAL_ERROR "Cannot identify Visual Studio from compiler: ${compiler}. Use an MSVC preset or a Visual Studio solution.")
    endif()
    set(instance "${CMAKE_MATCH_1}")
    set(vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
    execute_process(COMMAND "${vswhere}" -all -products * -format json -utf8
      OUTPUT_VARIABLE installations RESULT_VARIABLE result ENCODING UTF-8)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot query installed Visual Studio instances")
    endif()
    string(JSON count LENGTH "${installations}")
    set(major "")
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(index RANGE 0 ${last})
        string(JSON path GET "${installations}" ${index} installationPath)
        file(TO_CMAKE_PATH "${path}" path)
        string(TOLOWER "${path}" path)
        string(TOLOWER "${instance}" expected)
        if(path STREQUAL expected)
          string(JSON version GET "${installations}" ${index} installationVersion)
          string(REGEX MATCH "^[0-9]+" major "${version}")
          break()
        endif()
      endforeach()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --help OUTPUT_VARIABLE help)
    string(REGEX MATCH "Visual Studio ${major} [0-9]+" generator "${help}")
    if(NOT major OR NOT generator)
      message(FATAL_ERROR "This CMake does not support the active Visual Studio installation. Update the Visual Studio CMake tools.")
    endif()
  endif()
  set(arguments -G "${generator}")
  if(instance)
    list(APPEND arguments "-DCMAKE_GENERATOR_INSTANCE=${instance}")
  endif()
  if(CMAKE_GENERATOR_TOOLSET)
    list(APPEND arguments -T "${CMAKE_GENERATOR_TOOLSET}")
  elseif(MSVC_TOOLSET_VERSION)
    list(APPEND arguments -T "v${MSVC_TOOLSET_VERSION}")
  endif()
  set(ZBAR1C_SECONDARY_VS_ARGUMENTS "${arguments}" PARENT_SCOPE)
endfunction()
